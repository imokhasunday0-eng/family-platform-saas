import { headers } from "next/headers";
import { auth } from "@/server/auth/auth";
import { prisma } from "@/lib/prisma";
import { MealPlannerView } from "@/components/meal-planner-view";

export default async function MealPlannerPage() {
  const session = await auth.api.getSession({ headers: await headers() });
  if (!session?.user) return null;

  const membership = await prisma.familyMember.findFirst({
    where: { userId: session.user.id },
  });
  if (!membership) return null;

  const meals = await prisma.mealPlan.findMany({
    where: {
      familyId: membership.familyId,
      date: { gte: new Date(new Date().setHours(0, 0, 0, 0)) },
    },
    orderBy: { date: "asc" },
    include: { recipe: { select: { title: true } } },
  });

  const serialized = meals.map((m) => ({
    id: m.id,
    date: m.date.getFullYear() + "-" + String(m.date.getMonth() + 1).padStart(2, "0") + "-" + String(m.date.getDate()).padStart(2, "0"),
    mealType:
      m.mealType.charAt(0).toUpperCase() + m.mealType.slice(1).toLowerCase(),
    name: m.recipe.title,
  }));

  return (
    <main className="min-h-screen bg-gradient-to-b from-indigo-50 via-purple-50 to-teal-50 dark:from-gray-950 dark:via-gray-900 dark:to-gray-950">
      <div className="mx-auto max-w-3xl px-4 py-7 sm:px-6 md:py-10">
        <p className="text-xs font-bold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">
          Meal Planner
        </p>
        <h1 className="mt-1 text-2xl font-bold tracking-tight text-slate-800 dark:text-slate-100">
          What&apos;s cooking?
        </h1>
        <p className="mt-2 text-xs text-slate-400">
          Pick a day and plan your family&apos;s breakfast, lunch and dinner.
        </p>

        <div className="mt-6">
          <MealPlannerView meals={serialized} />
        </div>
      </div>
    </main>
  );
}

